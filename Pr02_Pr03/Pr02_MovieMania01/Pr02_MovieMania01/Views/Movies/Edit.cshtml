@model MovieViewModel


@section Title {
    <div class=" d-flex justify-content-between align-items-center mb-2">
        @if (Model != null)
        {
            <h1>Edit movie</h1>
        }
        else
        {
            <h1 class ="text-danger">Movie could not be found!</h1>
        }

    </div>
}

<partial name="_Movie" model="@Model" />

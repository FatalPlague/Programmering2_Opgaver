@section Title {
    <h1>Welcome to Movie Mania!</h1>
}
        
<h2>The current date and time is: @DateTime.Now.ToString("dd-MM HH:mm")</h2>
    @{
        string greet = "";
        if (DateTime.Now.Hour < 12)
            {
                greet = "Good morning!";
            }
            else
            {
                greet = "Good Afternoon!";
            }
}
<h2>@greet</h2>


